<Window x:Class="SmartBinApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:SmartBinApp.Converters"
        xmlns:viewModels="clr-namespace:SmartBinApp.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="670" Width="1160"
        MinHeight="520" MinWidth="940"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Converters -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
        <converters:ConnectionStatusBrushConverter x:Key="ConnectionStatusBrush" />
        <converters:WasteTypeToBrushConverter x:Key="WasteTypeToBrush" />
        <converters:ModelStatusBrushConverter x:Key="ModelStatusBrush" />

        <!-- Card border style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="BorderBrush" Value="#1F2937" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <!-- Button styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#0F172A" />
                                <Setter Property="Foreground" Value="#475569" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E293B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Plastic (P) -->
        <Style x:Key="PlasticButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#38BDF8"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0EA5E9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#334155" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Paper (B) -->
        <Style x:Key="PaperButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#FBBF24"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F59E0B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B45309" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#334155" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Organic (O) -->
        <Style x:Key="OrganicButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#34D399"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#10B981" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#334155" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Set Zero (Z) -->
        <Style x:Key="SetZeroButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#34D399"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#10B981" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#334155" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Motor Selector (All / Plastic / Paper / Organic) -->
        <Style x:Key="MotorSelectorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Main workspace -->
            <RowDefinition Height="*"/>
            <!-- 2: Status bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =================== HEADER =================== -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,6" Background="#111827" CornerRadius="10" BorderBrush="#1F2937" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Titles -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="#1E293B" CornerRadius="8" Margin="0,0,10,0" BorderBrush="#38BDF8" BorderThickness="1">
                        <TextBlock Text="♻" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#38BDF8"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="{Binding HeaderSubtitle}" FontSize="10.5" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badges & Language Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Selector ComboBox -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="3,2" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                        <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Background="Transparent" Foreground="#F1F5F9"
                                  BorderThickness="0" FontSize="11" FontWeight="SemiBold"
                                  VerticalContentAlignment="Center" Width="105"/>
                    </Border>

                    <!-- Arduino Status -->
                    <Border Background="#1E293B" CornerRadius="16" Padding="8,4" Margin="0,0,6,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{Binding ArduinoStatusBrush}"/>
                            <TextBlock Text="{Binding ArduinoStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ArduinoStatusBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Camera Status -->
                    <Border Background="#1E293B" CornerRadius="16" Padding="8,4" Margin="0,0,6,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#94A3B8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCameraRunning}" Value="True">
                                                <Setter Property="Fill" Value="#38BDF8" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding CameraStatusText}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#94A3B8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCameraRunning}" Value="True">
                                                <Setter Property="Foreground" Value="#38BDF8" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- AI Model Status -->
                    <Border Background="#1E293B" CornerRadius="16" Padding="8,4" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                     Fill="{Binding IsModelLoaded, Converter={StaticResource ModelStatusBrush}}"/>
                            <TextBlock Text="{Binding ModelStatusBadge}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding IsModelLoaded, Converter={StaticResource ModelStatusBrush}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =================== MAIN WORKSPACE =================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Video feed -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Control panels -->
                <ColumnDefinition Width="410"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: VIDEO FEED -->
            <Border Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Video Panel Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VideoMonitorTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                        </StackPanel>

                        <!-- FPS Indicator -->
                        <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="6" Padding="6,2"
                                Visibility="{Binding IsCameraRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding CameraFps, StringFormat='{}{0:F1} FPS'}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </DockPanel>

                    <!-- Frame Display Area -->
                    <Border Grid.Row="1" Background="#070A10" CornerRadius="8" ClipToBounds="True" BorderBrush="#1E293B" BorderThickness="1">
                        <Grid>
                            <!-- Inactive Camera Placeholder -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsCameraRunning, Converter={StaticResource InverseBoolToVis}}">
                                <Border Width="44" Height="44" Background="#111827" CornerRadius="22" Margin="0,0,0,8" BorderBrush="#374151" BorderThickness="1">
                                    <TextBlock Text="📷" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                                </Border>
                                <TextBlock Text="{Binding CameraPlaceholderTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CameraPlaceholderDesc}"
                                           FontSize="11" Foreground="#64748B" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Live Camera Image Feed -->
                            <Image x:Name="CameraStreamImage"
                                   Source="{Binding CurrentFrame}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding IsCameraRunning, Converter={StaticResource BoolToVis}}"/>

                            <!-- LIVE Overlay -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                    Background="#CC0F172A" CornerRadius="6" Padding="6,3"
                                    Visibility="{Binding IsCameraRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,5,0"/>
                                    <TextBlock Text="LIVE FEED" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Camera Controls -->
                    <DockPanel Grid.Row="2" Margin="0,6,0,0">
                        <Button Content="{Binding CameraToggleText}"
                                Command="{Binding ToggleCameraCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="145" HorizontalAlignment="Left"
                                Padding="8,5" FontSize="11.5"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="📷" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" Opacity="0.7"/>
                            <ComboBox ItemsSource="{Binding AvailableCameras}"
                                      SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      ToolTip="{Binding CameraTooltip}"
                                      Width="175" Background="#0F172A" Foreground="#FFFFFF"
                                      Padding="6,4" FontSize="11" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: CONTROLS & DETECTION (Wrapped in ScrollViewer with compact spacing) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                <StackPanel>
                    <!-- 1. CARD: ARDUINO SERIAL UART -->
                    <Border Margin="0,0,0,6" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding SerialCardTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,5"/>

                            <!-- COM Port Selector -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox ItemsSource="{Binding AvailablePorts}"
                                          SelectedItem="{Binding SelectedPortDevice, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="{Binding SerialComboTooltip}"
                                          Background="#0F172A" Foreground="#FFFFFF"
                                          Padding="8,4" FontSize="11" VerticalContentAlignment="Center"/>

                                <Button Grid.Column="1"
                                        Command="{Binding RefreshPortsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="{Binding RefreshPortsTooltip}"
                                        Margin="4,0,0,0" Width="30" Padding="0">
                                    <TextBlock Text="🔄" FontSize="11"/>
                                </Button>
                            </Grid>

                            <!-- Connect / Disconnect / Auto-Detect Buttons -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.15*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding ConnectBtn}"
                                        Command="{Binding ConnectCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="4,5" FontSize="11"
                                        Margin="0,0,2,0"/>

                                <Button Grid.Column="1"
                                        Content="{Binding DisconnectBtn}"
                                        Command="{Binding DisconnectCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="4,5" FontSize="11"
                                        Margin="2,0,2,0"/>

                                <Button Grid.Column="2"
                                        Content="{Binding AutoConnectBtn}"
                                        Command="{Binding AutoDetectAndConnectCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Background="#059669"
                                        Padding="4,5" FontSize="11"
                                        Margin="2,0,0,0"
                                        ToolTip="{Binding AutoConnectTooltip}"/>
                            </Grid>

                            <!-- Demo Mode Checkbox -->
                            <Border Padding="6,3" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                                <CheckBox Content="{Binding DemoModeCheckbox}"
                                          IsChecked="{Binding IsDemoModeEnabled}"
                                          ToolTip="{Binding DemoModeTooltip}"
                                          Foreground="#FBBF24" FontSize="11" FontWeight="SemiBold"
                                          VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. CARD: AI RECOGNITION (YOLOv8) -->
                    <Border Margin="0,0,0,6" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding AiModelCardTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                <TextBlock Text="{Binding ModelStatusBadge}" DockPanel.Dock="Right" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Model Selection -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableModels}"
                                          SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          Background="#0F172A" Foreground="#F1F5F9"
                                          BorderBrush="#334155" Padding="6,4" FontSize="10.5" Margin="0,0,4,0"
                                          ToolTip="{Binding ModelComboTooltip}"/>

                                <Button Grid.Column="1"
                                        Content="{Binding BrowseModelBtn}"
                                        Command="{Binding LoadModelCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="6,4" FontSize="10.5"
                                        ToolTip="{Binding BrowseModelTooltip}"/>
                            </Grid>

                            <!-- Auto-sorting & Threshold -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Content="{Binding AutoSortCheckbox}"
                                          IsChecked="{Binding IsAutoModeEnabled}"
                                          Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold"
                                          VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1" Text="{Binding ConfidenceThresholdLabel}"
                                           FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Threshold Slider -->
                            <Slider Minimum="0.20" Maximum="0.95" SmallChange="0.05" LargeChange="0.10"
                                    Value="{Binding ConfidenceThreshold, Mode=TwoWay}"
                                    Margin="0,0,0,4"/>

                            <!-- Current Detection Indicator -->
                            <Border Background="#0B132B" CornerRadius="6" Padding="6,4"
                                    BorderBrush="{Binding LastDetectedCategory, Converter={StaticResource WasteTypeToBrush}}"
                                    BorderThickness="1.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentDetectionLabel}" FontSize="9.5" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding LastDetectionText}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{Binding LastDetectedCategory, Converter={StaticResource WasteTypeToBrush}}"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="6,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LastDetectedCategory}" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{Binding LastDetectedCategory, Converter={StaticResource WasteTypeToBrush}}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3. CARD: MANUAL COMPARTMENT TESTING & MOTOR CALIBRATION -->
                    <Border Margin="0,0,0,6" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding ManualTestingCardTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                            </DockPanel>

                            <!-- Motor Busy Indicator -->
                            <Border Background="#1E293B" CornerRadius="6" Padding="6,3" Margin="0,0,0,5"
                                    Visibility="{Binding IsArduinoBusy, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ServoBusyText}"
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#FBBF24" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Simulation Buttons -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="{Binding BtnPlastic}"
                                        Command="{Binding SimulatePlasticCommand}"
                                        Style="{StaticResource PlasticButtonStyle}"
                                        Padding="3,5" FontSize="10.5" Margin="0,0,2,0"/>

                                <Button Grid.Column="1" Content="{Binding BtnPaper}"
                                        Command="{Binding SimulatePaperCommand}"
                                        Style="{StaticResource PaperButtonStyle}"
                                        Padding="3,5" FontSize="10.5" Margin="2,0,2,0"/>

                                <Button Grid.Column="2" Content="{Binding BtnOrganic}"
                                        Command="{Binding SimulateOrganicCommand}"
                                        Style="{StaticResource OrganicButtonStyle}"
                                        Padding="3,5" FontSize="10.5" Margin="2,0,0,0"/>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="#1F2937" Margin="0,0,0,5"/>

                            <!-- Calibration Section Header -->
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="{Binding CalibrationTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                <TextBlock Text="{Binding SelectedMotorName, StringFormat='{}🎯 {0}'}" DockPanel.Dock="Right"
                                           FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding CalibrationDesc}" FontSize="9.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,4"/>

                            <!-- Motor Selection Buttons (NEW: Select Which Motor to Calibrate!) -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="1.15*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="{Binding CalibrationMotorAll}"
                                        Command="{Binding SelectMotorAllCommand}"
                                        Margin="0,0,2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MotorSelectorButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMotorAllSelected}" Value="True">
                                                    <Setter Property="Background" Value="#0284C7" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="1" Content="{Binding CalibrationMotorPlastic}"
                                        Command="{Binding SelectMotorPlasticCommand}"
                                        Margin="2,0,2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MotorSelectorButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMotorPlasticSelected}" Value="True">
                                                    <Setter Property="Background" Value="#D97706" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#FBBF24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="2" Content="{Binding CalibrationMotorPaper}"
                                        Command="{Binding SelectMotorPaperCommand}"
                                        Margin="2,0,2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MotorSelectorButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMotorPaperSelected}" Value="True">
                                                    <Setter Property="Background" Value="#2563EB" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#60A5FA" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="3" Content="{Binding CalibrationMotorOrganic}"
                                        Command="{Binding SelectMotorOrganicCommand}"
                                        Margin="2,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MotorSelectorButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMotorOrganicSelected}" Value="True">
                                                    <Setter Property="Background" Value="#059669" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#34D399" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- Calibration Step / Zero Buttons -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="{Binding BtnNudgeLeft}"
                                        Command="{Binding NudgeLeftCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="2,5" FontSize="10.5" Margin="0,0,2,0"/>

                                <Button Grid.Column="1" Content="{Binding BtnSetZero}"
                                        Command="{Binding SetZeroCommand}"
                                        Style="{StaticResource SetZeroButtonStyle}"
                                        Padding="2,5" FontSize="10.5" Margin="2,0,2,0"/>

                                <Button Grid.Column="2" Content="{Binding BtnNudgeRight}"
                                        Command="{Binding NudgeRightCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="2,5" FontSize="10.5" Margin="2,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. CARD: EVENT LOG & TELEMETRY -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <!-- Log Header -->
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding EventLogCardTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding ClearLogsBtn}"
                                        Command="{Binding ClearLogsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="5,2" FontSize="10"/>
                            </DockPanel>

                            <!-- Log Messages List -->
                            <Border Height="110" Background="#0A0E17" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1">
                                <ListBox ItemsSource="{Binding Logs}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Padding="4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FormattedTime}"
                                                           FontSize="10" FontFamily="Consolas, Cascadia Code, monospace"
                                                           Foreground="#64748B" Margin="0,0,5,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Message}"
                                                           TextWrapping="Wrap"
                                                           FontSize="10.5" FontFamily="Consolas, Cascadia Code, monospace"
                                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- =================== STATUS BAR =================== -->
        <Border Grid.Row="2" Margin="0,6,0,0" Padding="8,4" Background="#131C2E" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#38BDF8"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right" Text="{Binding FooterText}"
                           FontSize="10.5" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
